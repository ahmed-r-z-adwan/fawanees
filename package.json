{
  "name": "fawanees",
  "version": "0.4.0",
  "private": true,
  "description": "Fawanees - a two-player game of light and shadow. Rules, balancing and AI by Claude (Anthropic); idea and publishing by Ahmed Adwan.",
  "type": "commonjs",
  "scripts": {
    "build": "python build.py",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:browser": "node --test --test-concurrency=1 \"test/browser/**/*.test.js\"",
    "bench": "node sim/bench.js",
    "opening": "node sim/openingMatrix.js",
    "calibrate": "node sim/calibrate.js",
    "puzzles": "node sim/minePuzzles.js"
  },
  "devDependencies": {
    "puppeteer": "^25.12.0"
  }
}
