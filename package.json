{
  "name": "fawanees",
  "version": "0.4.0",
  "private": true,
  "description": "Fawanees - a two-player strategy game of light and shadow. Idea by Ahmed Adwan, implementation by Claude (Anthropic).",
  "type": "commonjs",
  "scripts": {
    "build": "python build.py",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:browser": "node --test --test-concurrency=1 \"test/browser/**/*.test.js\"",
    "bench": "node sim/bench.js",
    "opening": "node sim/openingMatrix.js",
    "calibrate": "node sim/calibrate.js",
    "puzzles": "node sim/minePuzzles.js"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "puppeteer": "^25.12.0"
  },
  "homepage": "https://ahmed-r-z-adwan.github.io/fawanees/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmed-r-z-adwan/fawanees.git"
  }
}
